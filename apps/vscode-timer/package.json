{
  "name": "doit-timer",
  "displayName": "doit Timer",
  "description": "Cronómetro de horas por proyecto, conectado a la app doit (Freelance).",
  "version": "0.1.0",
  "private": true,
  "publisher": "doit",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "doit.startTimer",
        "title": "doit: Iniciar cronómetro"
      },
      {
        "command": "doit.stopTimer",
        "title": "doit: Parar cronómetro"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.10.0",
    "typescript": "~5.7.0"
  }
}
